---
const links = [
  { href: '#about', label: 'About' },
  { href: '#music', label: 'Music' },
  { href: '#videos', label: 'Videos' },
  { href: '#concerts', label: 'Concerts' },
  { href: '#gallery', label: 'Gallery' },
  { href: '#organizers', label: 'For organizers' },
];
---

<header class="nav">
  <div class="nav-inner wrap">
    <a class="brand" href="#top">La Familia</a>

    <nav aria-label="Sections">
      <button class="menu-toggle" aria-expanded="false" aria-controls="nav-links">
        <span class="menu-icon" aria-hidden="true"></span>
        Menu
      </button>
      <ul id="nav-links" class="links">
        {links.map(({ href, label }) => (
          <li><a href={href}>{label}</a></li>
        ))}
        <li><a class="btn btn--solid nav-cta" href="#contact">Book the band</a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const list = document.getElementById('nav-links');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    list?.classList.toggle('open', !open);
  });

  list?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) {
      toggle?.setAttribute('aria-expanded', 'false');
      list.classList.remove('open');
    }
  });
</script>

<style>
  .nav {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--ink) 78%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4rem;
  }

  .brand {
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--cream);
    text-decoration: none;
  }

  .brand:hover {
    color: var(--brass-hi);
  }

  .links {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    list-style: none;
  }

  .links a:not(.nav-cta) {
    font-size: 0.88rem;
    font-weight: 560;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--cream-dim);
    text-decoration: none;
  }

  .links a:not(.nav-cta):hover {
    color: var(--brass-hi);
  }

  .nav-cta {
    padding: 0.5rem 1.1rem;
    font-size: 0.8rem;
  }

  .menu-toggle {
    display: none;
    align-items: center;
    gap: 0.5rem;
    background: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--cream);
    font: inherit;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.45rem 1rem;
    cursor: pointer;
  }

  .menu-icon {
    width: 14px;
    height: 2px;
    background: var(--brass);
    box-shadow: 0 -5px 0 var(--brass), 0 5px 0 var(--brass);
  }

  @media (max-width: 56rem) {
    .menu-toggle {
      display: inline-flex;
    }

    .links {
      display: none;
      position: absolute;
      top: 100%;
      inset-inline: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: var(--ink);
      border-bottom: 1px solid var(--line);
      padding: 0.5rem var(--gutter) 1.25rem;
    }

    .links.open {
      display: flex;
    }

    .links li a:not(.nav-cta) {
      display: block;
      padding: 0.8rem 0;
    }

    .nav-cta {
      justify-content: center;
      margin-top: 0.75rem;
    }
  }
</style>
