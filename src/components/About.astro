---
import { Image } from 'astro:assets';
import ClaveDivider from './ClaveDivider.astro';
import { site } from '../data/site';
import bandPhoto from '../assets/photos/band-full.jpg';
import duoPhoto from '../assets/photos/duo.png';
---

<section id="about" class="section">
  <div class="wrap">
    <ClaveDivider />
    <div class="section-head" style="margin-top: clamp(2rem, 5vw, 3.5rem);">
      <p class="eyebrow">About Familia</p>
      <h2>Ten musicians, two voices, one dance floor</h2>
    </div>

    <div class="grid">
      <div class="text">
        <p>
          La Familia Salsa Band is a Prague-based orchestra playing Cuban salsa,
          Dominican bachata and cha-cha-cha — traditional songs, popular hits and
          original music. The group brings together musicians from Czechia,
          Slovakia and Italy: young players, dancers and dance teachers, fronted
          by two lead vocalists.
        </p>
        <p>
          Salsa and bachata dance animations or lessons are part of every
          performance, so the concerts always carry an original, enthusiastic
          atmosphere. Founded in September 2015, La Familia performs regularly at
          salsa parties, festivals and city stages across the Czech Republic and
          Germany.
        </p>
        <p>
          The full orchestra counts up to ten musicians — singers, piano, bass,
          guitar, brass and percussion — and we guarantee at least eight on stage
          at any event. On request we also perform as a smaller ensemble, from
          duo to septet.
        </p>

        <dl class="facts">
          <div><dt>On stage</dt><dd>8–10 musicians</dd></div>
          <div><dt>Founded</dt><dd>September 2015</dd></div>
          <div><dt>Performs in</dt><dd>Czechia &amp; Germany</dd></div>
          <div><dt>Also available</dt><dd>Duo to septet</dd></div>
        </dl>
      </div>

      <div class="photos">
        <Image
          src={bandPhoto}
          widths={[480, 720, 1000]}
          sizes="(max-width: 56rem) 100vw, 40vw"
          alt="The full La Familia Salsa Band lineup"
          class="band-photo"
        />
        <div class="duo-card">
          <Image
            src={duoPhoto}
            widths={[480, 700]}
            sizes="(max-width: 56rem) 45vw, 18vw"
            alt="La Familia duo — Elinor and Laci"
            class="duo-photo"
          />
          <div class="duo-copy">
            <p class="duo-label">La Familia duo</p>
            <p class="duo-names">Elinor &amp; Laci</p>
            <p class="duo-desc">
              Popular Latin repertoire for smaller events, including
              originals from <a href={site.links.elinorAlbum}>Elinor Marsi's album</a>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .text p + p {
    margin-top: 1.1rem;
  }

  .text p {
    color: var(--cream-dim);
    max-width: var(--measure);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem 1.25rem;
    margin-top: 2.2rem;
    padding-top: 1.8rem;
    border-top: 1px solid var(--line);
  }

  .facts dt {
    font-size: 0.75rem;
    font-weight: 620;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brass);
  }

  .facts dd {
    margin-top: 0.3rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
  }

  .photos {
    display: grid;
    gap: 1.25rem;
  }

  .photos :global(.band-photo) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
  }

  .duo-card {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    padding: 1.1rem;
    background: var(--surface);
    border-radius: var(--radius);
  }

  .duo-card :global(.duo-photo) {
    flex-shrink: 0;
    width: 5.5rem;
    height: 5.5rem;
    border-radius: 50%;
    object-fit: cover;
    object-position: top center;
  }

  .duo-label {
    font-size: 0.72rem;
    font-weight: 640;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brass);
  }

  .duo-names {
    margin-top: 0.15rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
  }

  .duo-desc {
    margin-top: 0.35rem;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--cream-faint);
  }

  @media (max-width: 56rem) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 26rem) {
    .facts {
      grid-template-columns: 1fr;
    }

    .duo-card {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
