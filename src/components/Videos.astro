---
import YouTubeFacade from './YouTubeFacade.astro';
import { promoVideo, concertVideos } from '../data/videos';
import { site } from '../data/site';
---

<section id="videos" class="section">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Videos</p>
      <h2>See the band in action</h2>
      <p>
        More live recordings and reels on
        <a href={site.socials.youtube}>YouTube</a> and
        <a href={site.socials.instagram}>Instagram</a>.
      </p>
    </div>

    <div class="featured">
      <YouTubeFacade id={promoVideo.id} title={promoVideo.title} large />
    </div>

    <div class="grid">
      {concertVideos.map((video) => <YouTubeFacade id={video.id} title={video.title} />)}
      <a class="more" href={site.socials.youtube}>
        <span class="more-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22">
            <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
        <span>More on YouTube</span>
      </a>
    </div>
  </div>
</section>

<style>
  .featured {
    margin-bottom: 1.5rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .more {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    aspect-ratio: 16 / 9;
    border: 1px dashed var(--line-hi);
    border-radius: 8px;
    color: var(--cream-dim);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 560;
    transition: border-color 150ms ease, color 150ms ease;
  }

  .more:hover {
    border-color: var(--brass);
    color: var(--brass-hi);
  }

  .more-icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1px solid currentColor;
  }

  :global(.youtube-frame) {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 8px;
  }

  @media (max-width: 56rem) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 34rem) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
